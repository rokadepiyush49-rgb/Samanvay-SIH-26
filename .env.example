# Copy to .env and replace every placeholder, or run `python3 scripts/gen_env.py` to generate local secrets.
# Never commit a real .env.

APP_ENV=development            # development | test | demo | production
DEMO_MODE=true                 # one-click role switching for the stage demo; refused when APP_ENV=production

# Three database roles: API (row-level security enforced), worker (BYPASSRLS, for cross-unit matching), schema owner.
DATABASE_URL=postgresql+psycopg://samanvay_app:CHANGE_ME_APP@localhost:5432/samanvay
WORKER_DATABASE_URL=postgresql+psycopg://samanvay_worker:CHANGE_ME_WORKER@localhost:5432/samanvay
MIGRATION_DATABASE_URL=postgresql+psycopg://samanvay_owner:CHANGE_ME_OWNER@localhost:5432/samanvay
DB_OWNER_PASSWORD=CHANGE_ME_OWNER
DB_APP_PASSWORD=CHANGE_ME_APP
DB_WORKER_PASSWORD=CHANGE_ME_WORKER

JWT_SECRET=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
FIELD_ENCRYPTION_KEY=CHANGE_ME_FERNET_KEY_BASE64
HMAC_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
AUDIT_SIGNING_KEY=CHANGE_ME_BASE64_32_BYTE_ED25519_SEED
SEED_DEMO_PASSWORD=CHANGE_ME_DEMO_PASSWORD

SESSION_MINUTES=30
COOKIE_SECURE=false            # must be true behind TLS / in production
PUBLIC_BASE_URL=http://localhost:3000

STORAGE_BACKEND=local          # local | s3
STORAGE_PATH=./var/documents
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=samanvay-documents
# S3_ACCESS_KEY=CHANGE_ME
# S3_SECRET_KEY=CHANGE_ME

SCANNER=builtin                # builtin (EICAR only, development) | clamav (required in production)
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# SMTP_HOST=localhost          # e.g. MailHog in the demo; unset = e-mail notifications are skipped
SMTP_PORT=1025
SMTP_FROM=samanvay-noreply@localhost

TEXT_BACKEND=ngram             # ngram | embedding (needs the "embeddings" extra and a model download)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
